# Gemini AI Configuration (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here

# Session Secret for signed session cookies (REQUIRED for production)
# Generate a secure random string of at least 32 characters
# Example: openssl rand -base64 32
SESSION_SECRET=your_random_secret_here_min_32_chars

# Optional: Rate Limiting (legacy IP-based middleware)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Note: Session-based quota limits (30/day, 5/minute) are enforced server-side
# No database configuration required - using signed cookies for stateless session tracking

# Public Site Origin (OPTIONAL - used for shareable idea links)
# In production, set to your public domain (e.g., https://ideaprinter.rytix.tech)
# In local dev, defaults to window.location.origin when not set
NEXT_PUBLIC_SITE_ORIGIN=https://ideaprinter.rytix.tech
